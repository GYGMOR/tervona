# Kopieren nach .env.local (lokal) bzw. in Vercel unter Settings → Environment Variables eintragen.
# Alle Werte sind optional.

# Kontaktformular-Endpunkt (z. B. https://formspree.io/f/xxxxxxx)
NEXT_PUBLIC_FORM_ENDPOINT=

# Google PageSpeed Insights API-Schlüssel für den Website-Check
NEXT_PUBLIC_PSI_KEY=

# Cal.com-Link für die Terminbuchung (z. B. https://cal.com/trevona/erstgespraech)
NEXT_PUBLIC_BOOKING_URL=
